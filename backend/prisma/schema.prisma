generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
  staff
}

enum MovieStatus {
  upcoming
  now_showing
  archived
}

enum ShowStatus {
  scheduled
  cancelled
  completed
}

enum SeatStatus {
  available
  locked
  booked
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  expired
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum PaymentMethod {
  card
  upi
  netbanking
  wallet
  cash
}

// =====================================================================
// USER  (customers, staff, admins — single table with role flag)
// =====================================================================
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(customer)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  bookings         Booking[]
  createdShows     Show[]               @relation("ShowCreatedBy")
  lockedSeats      ShowSeat[]           @relation("SeatLockedBy")
  adminActivityLogs AdminActivityLog[]

  @@map("users")
}

// =====================================================================
// SCREEN  (2 screens in your hall, kept generic for future expansion)
// =====================================================================
model Screen {
  id            Int      @id @default(autoincrement())
  name          String                          // 'Screen 1', 'Screen 2'
  totalRows     Int      @map("total_rows")
  totalColumns  Int      @map("total_columns")
  soundSystem   String?  @map("sound_system")    // 'Dolby Atmos'
  screenFormat  String?  @map("screen_format")   // '2D', '3D', 'IMAX'
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  seats Seat[]
  shows Show[]

  @@map("screens")
}

// =====================================================================
// SEAT CATEGORY  (pricing tiers e.g. Regular / Premium / Recliner)
// =====================================================================
model SeatCategory {
  id        Int     @id @default(autoincrement())
  name      String  @unique                       // 'Regular', 'Premium', 'Recliner'
  basePrice Decimal @map("base_price") @db.Decimal(8, 2)

  // Relations
  seats Seat[]

  @@map("seat_categories")
}

// =====================================================================
// SEAT  (physical seat map per screen — fixed layout)
// =====================================================================
model Seat {
  id         Int     @id @default(autoincrement())
  screenId   Int     @map("screen_id")
  categoryId Int     @map("category_id")
  seatRow    String  @map("seat_row") @db.VarChar(2)   // 'A', 'B' ...
  seatNumber Int     @map("seat_number")               // 1, 2, 3 ...
  isActive   Boolean @default(true) @map("is_active")  // disable broken seats

  // Relations
  screen     Screen        @relation(fields: [screenId], references: [id], onDelete: Cascade)
  category   SeatCategory  @relation(fields: [categoryId], references: [id])
  showSeats  ShowSeat[]

  @@unique([screenId, seatRow, seatNumber])
  @@index([screenId])
  @@map("seats")
}

// =====================================================================
// MOVIE
// =====================================================================
model Movie {
  id            String      @id @default(uuid())
  title         String
  description   String?
  durationMin   Int         @map("duration_min")
  language      String
  genre         String?
  releaseDate   DateTime?   @map("release_date") @db.Date
  posterUrl     String?     @map("poster_url")
  trailerUrl    String?     @map("trailer_url")
  censorRating  String?     @map("censor_rating") @db.VarChar(10) // 'U', 'U/A', 'A'
  status        MovieStatus @default(upcoming)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  shows Show[]

  @@index([status])
  @@map("movies")
}

// =====================================================================
// SHOW  (a movie playing on a specific screen at a specific time)
// =====================================================================
model Show {
  id         String     @id @default(uuid())
  movieId    String     @map("movie_id")
  screenId   Int        @map("screen_id")
  showDate   DateTime   @map("show_date") @db.Date
  startTime  DateTime   @map("start_time") @db.Time
  endTime    DateTime   @map("end_time") @db.Time
  status     ShowStatus @default(scheduled)
  createdById String?   @map("created_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  // Relations
  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  screen     Screen     @relation(fields: [screenId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("ShowCreatedBy", fields: [createdById], references: [id])
  showSeats  ShowSeat[]
  bookings   Booking[]

  @@unique([screenId, showDate, startTime])
  @@index([movieId])
  @@index([screenId])
  @@index([showDate])
  @@map("shows")
}

// =====================================================================
// SHOW_SEAT  (per-show seat status & price — the booking engine core)
// One row per seat per show.
// =====================================================================
model ShowSeat {
  id         BigInt     @id @default(autoincrement())
  showId     String     @map("show_id")
  seatId     Int        @map("seat_id")
  price      Decimal    @db.Decimal(8, 2)
  status     SeatStatus @default(available)
  lockedById String?    @map("locked_by")
  lockedAt   DateTime?  @map("locked_at")

  // Relations
  show         Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  seat         Seat           @relation(fields: [seatId], references: [id], onDelete: Cascade)
  lockedByUser User?          @relation("SeatLockedBy", fields: [lockedById], references: [id])
  bookingSeat  BookingSeat?

  @@unique([showId, seatId])
  @@index([showId, status])
  @@map("show_seats")
}

// =====================================================================
// BOOKING
// =====================================================================
model Booking {
  id           String        @id @default(uuid())
  bookingRef   String        @unique @map("booking_ref")   // 'BK2026090801'
  userId       String        @map("user_id")
  showId       String        @map("show_id")
  totalAmount  Decimal       @map("total_amount") @db.Decimal(10, 2)
  status       BookingStatus @default(pending)
  bookedAt     DateTime      @default(now()) @map("booked_at")
  expiresAt    DateTime?     @map("expires_at")             // TTL for pending/unpaid bookings
  cancelledAt  DateTime?     @map("cancelled_at")

  // Relations
  user          User            @relation(fields: [userId], references: [id])
  show          Show            @relation(fields: [showId], references: [id])
  bookingSeats  BookingSeat[]
  payments      Payment[]
  couponUsage   BookingCoupon?

  @@index([userId])
  @@index([showId])
  @@index([status])
  @@map("bookings")
}

// =====================================================================
// BOOKING_SEAT  (which seats belong to which booking)
// =====================================================================
model BookingSeat {
  id          BigInt  @id @default(autoincrement())
  bookingId   String  @map("booking_id")
  showSeatId  BigInt  @unique @map("show_seat_id")   // a seat-for-a-show → one booking only
  price       Decimal @db.Decimal(8, 2)

  // Relations
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id])

  @@index([bookingId])
  @@map("booking_seats")
}

// =====================================================================
// PAYMENT
// =====================================================================
model Payment {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  transactionRef  String?       @map("transaction_ref")
  status          PaymentStatus @default(pending)
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

// =====================================================================
// COUPON  (optional discount system)
// =====================================================================
model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  description    String?
  discountType   String   @map("discount_type")     // 'flat' | 'percent'
  discountValue  Decimal  @map("discount_value") @db.Decimal(8, 2)
  maxDiscount    Decimal? @map("max_discount") @db.Decimal(8, 2)
  validFrom      DateTime? @map("valid_from")
  validUntil     DateTime? @map("valid_until")
  usageLimit     Int?     @map("usage_limit")
  timesUsed      Int      @default(0) @map("times_used")
  isActive       Boolean  @default(true) @map("is_active")

  // Relations
  bookingCoupons BookingCoupon[]

  @@map("coupons")
}

model BookingCoupon {
  bookingId        String  @id @map("booking_id")
  couponId         Int     @map("coupon_id")
  discountApplied  Decimal @map("discount_applied") @db.Decimal(8, 2)

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coupon  Coupon  @relation(fields: [couponId], references: [id])

  @@map("booking_coupons")
}

// =====================================================================
// ADMIN ACTIVITY LOG  (audit trail for the admin panel)
// =====================================================================
model AdminActivityLog {
  id         BigInt   @id @default(autoincrement())
  adminId    String   @map("admin_id")
  action     String                          // 'CREATE_SHOW', 'CANCEL_SHOW', 'UPDATE_MOVIE'
  entityType String   @map("entity_type")    // 'movie', 'show', 'user'
  entityId   String?  @map("entity_id")
  details    Json?                           // flexible payload of what changed
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_activity_logs")
}

